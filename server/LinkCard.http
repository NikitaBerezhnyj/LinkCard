### GET HealthCheck
GET {{apiURL}}/healthcheck

### POST Registration
POST {{apiURL}}/register
Content-Type: application/json

{
  "username": "TestUser123",
  "email": "test.user@example.com",
  "password": "TestPass123!"
}

### POST Login
POST {{apiURL}}/login
Content-Type: application/json

{
  "email": "test.user@example.com",
  "password": "TestPass123!"
}

### GET User by username
GET {{apiURL}}/user/TestUser123

### POST Refresh Token
POST {{apiURL}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### POST Logout
POST {{apiURL}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### PATCH Update bio
PATCH {{apiURL}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "bio": "Hello! I'm a demo user for API testing."
}

### PATCH Update links
PATCH {{apiURL}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "links": [
    { "title": "Email", "url": "test.user@example.com" },
    { "title": "GitHub Profile", "url": "https://github.com/demo-user" }
  ]
}

### PATCH Update styles (partial merge)
PATCH {{apiURL}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "styles": {
    "typography": { "fontSize": "20px" }
  }
}

### PATCH Update username & email
PATCH {{apiURL}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "username": "UpdatedUser",
  "email": "updated.user@example.com"
}

### DELETE current user
DELETE {{apiURL}}/user/me
Authorization: Bearer {{accessToken}}

